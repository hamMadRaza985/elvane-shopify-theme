
[
  {
    "name": "theme_info",
    "theme_name": "ELVANE",
    "theme_version": "0.2.0",
    "theme_author": "ELVANE",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "cormorant_garamond_n5",
        "label": "Heading font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "inter_n4",
        "label": "Body and interface font"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 140,
        "step": 5,
        "unit": "%",
        "label": "Heading scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 85,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body text scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Maximum page width",
        "options": [
          {"value": "90rem", "label": "Narrow"},
          {"value": "110rem", "label": "Wide"},
          {"value": "120rem", "label": "Extra wide"}
        ],
        "default": "110rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 12,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "Page side spacing",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 24,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Default section spacing",
        "default": 64
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 4
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "Button corner radius",
        "default": 2
      }
    ]
  },
